<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Cadastro de Usuários</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="brand-block">
                <a asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">C<small>#</small></span>
                </a>
                <div class="brand-title">Cadastro de Usuários</div>
            </div>

            <nav class="app-nav">
                <a asp-controller="Home" asp-action="Index">Início</a>
                <a asp-controller="Usuarios" asp-action="Index">Usuários</a>
                <a asp-controller="Usuarios" asp-action="Create">Novo usuário</a>
            </nav>
        </aside>

        <div class="app-main">
            @if (TempData["Mensagem"] != null)
            {
                <div class="flash">
                    <span>@TempData["Mensagem"]</span>
                    <button type="button" onclick="this.closest('.flash').remove()" aria-label="Fechar aviso">&times;</button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>

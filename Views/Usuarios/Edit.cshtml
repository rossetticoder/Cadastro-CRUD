@model Usuario

@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="page-head">
    <h1>Editar usuário</h1>
</div>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-cs"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DataCadastro" />

    <div class="form-panel">
        <div class="field-row">
            <label asp-for="Nome" class="field-label">
                Nome
                <span class="field-type">texto</span>
            </label>
            <div>
                <input asp-for="Nome" class="cs-input" autocomplete="name" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>
        </div>

        <div class="field-row">
            <label asp-for="Email" class="field-label">
                Email
                <span class="field-type">email</span>
            </label>
            <div>
                <input asp-for="Email" class="cs-input" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
        </div>

        @* O hash salvo nunca é exibido nem reenviado. O campo abaixo é opcional e
           não é vinculado a Model.Senha — o Controller precisa tratar "NovaSenha"
           separadamente: se vier vazio, mantém o hash atual; se vier preenchido,
           gera um novo hash a partir dele. *@
        <div class="field-row">
            <label for="NovaSenha" class="field-label">
                Nova senha
                <span class="field-type">opcional · mascarado</span>
            </label>
            <div>
                <input id="NovaSenha" name="NovaSenha" class="cs-input" type="password"
                       placeholder="Deixe em branco para manter a senha atual" autocomplete="new-password" />
                <p class="field-hint">O valor salvo é um hash e não é exibido por segurança. Preencha só se quiser trocá-lo.</p>
            </div>
        </div>

        <div class="field-row">
            <label asp-for="DataNascimento" class="field-label">
                Data de nascimento
                <span class="field-type">data</span>
            </label>
            <div>
                <input asp-for="DataNascimento" class="cs-input" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="DataNascimento" class="field-error"></span>
            </div>
        </div>

        <div class="field-row">
            <label asp-for="Telefone" class="field-label">
                Telefone
                <span class="field-type">texto · opcional</span>
            </label>
            <div>
                <input asp-for="Telefone" class="cs-input" type="tel" autocomplete="tel" />
                <span asp-validation-for="Telefone" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="form-footer">
        <button type="submit" class="btn-cs btn-cs-warning">Salvar alterações</button>
        <a asp-action="Index" class="btn-cs btn-cs-outline">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
